# Same model as in.LLVM, but the simulation runs as ONE `run` command with
# `stats ${deltat}` instead of Nstep separate `run ${deltat}` commands.
# The per-run loop in the original is inherited from the MUI-coupled version,
# which must return control to the fluid solver every deltat; spk_nonmui does not.
#
# Requires -var Trun <total time> in addition to the original variables.

app_style   surfchemtest
seed        ${seed}

dimension	2
boundary	p p p
lattice		sq/4n 1

variable    Lx equal ${xhi}
variable    Ly equal ${yhi}

region		sys_domain block 0 ${Lx} 0 ${Ly} -0.5 0.5
create_box	sys_domain
solve_style tree

read_sites  ${sitefile}

temperature 300

# i1: 1 (siteA), 2 (siteB), 3 (siteC)
# i2: 1 (spec1), 2 (spec2), 3 (spec3), 4 (spec4), 5 (spec5), 0 (vac)
set     i1 value 1
set     i2 value 0
set     i2 value 1 fraction 0.2
set     i2 value 2 fraction 0.375 if i2 = 0

event       2 siteA siteA vac spec1 ${k1} spec1 spec1
event       2 siteA siteA spec1 spec2 ${k2} spec2 spec2
event       1 siteA spec2 ${k3} vac 

stats       ${deltat}
diag_style 	surfchemtest stats yes list vac spec1 spec2

run         ${Trun}
